{
  "name": "8004-web3-agent-chat",
  "version": "0.1.0",
  "description": "Deploy autonomous AI agents on Arbitrum with LangChain, isolated wallets, and ERC-8004 identity registration.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:frontend": "vue-tsc -b frontend",
    "typecheck:all": "npm run typecheck && npm run typecheck:frontend",
    "setup": "npx tsx src/cli/setup.ts",
    "create-agent": "npx tsx src/cli/create-agent.ts",
    "delete-agent": "npx tsx src/cli/delete-agent.ts",
    "deploy": "npx tsx src/cli/deploy.ts",
    "chat": "npx tsx src/cli/chat.ts",
    "serve": "npx tsx src/server/api.ts",
    "dev:frontend": "vite frontend",
    "dev": "concurrently --kill-others --names \"api,frontend\" --prefix-colors \"cyan,magenta\" \"npm run serve\" \"npm run dev:frontend\"",
    "frontend": "npm run dev:frontend",
    "frontend:build": "vite build frontend",
    "preview": "vite preview frontend",
    "test": "npx tsx src/cli/test-workflow.ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:offline": "playwright test --grep-invert @onchain",
    "test:e2e:onchain": "PLAYWRIGHT_ONCHAIN=1 playwright test --grep @onchain",
    "test:e2e:ui": "playwright test --ui"
  },
  "keywords": [
    "arbitrum",
    "ai-agents",
    "web3",
    "langchain",
    "erc-8004",
    "defi",
    "autonomous-agents"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@blockbyvlog/agent0-sdk": "^1.5.6",
    "@clack/prompts": "^1.1.0",
    "@hono/node-server": "^2.1.1",
    "@langchain/anthropic": "^0.3.0",
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/openai": "^0.6.17",
    "@openrouter/sdk": "*",
    "@tanstack/vue-query": "^5.102.8",
    "@wagmi/connectors": "^8.2.0",
    "@wagmi/vue": "^0.5.30",
    "dompurify": "^3.4.15",
    "dotenv": "^16.4.0",
    "ethers": "^6.13.0",
    "graphql": "^17.0.2",
    "hono": "^4.13.7",
    "marked": "^18.0.11",
    "qrcode-terminal": "^0.12.0",
    "viem": "^2.56.3",
    "vue": "^3.5.41",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.3",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "22.x"
  }
}
