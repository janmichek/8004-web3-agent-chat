{
  "name": "8004-web3-agent-chat",
  "version": "0.1.0",
  "description": "Deploy autonomous AI agents on Arbitrum with LangChain, isolated wallets, and ERC-8004 identity registration.",
  "keywords": [
    "ai-agents",
    "arbitrum",
    "autonomous-agents",
    "defi",
    "erc-8004",
    "langchain",
    "web3"
  ],
  "license": "Apache-2.0",
  "workspaces": [
    "apps/frontend"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:frontend": "npm --prefix apps/frontend run typecheck",
    "typecheck:all": "npm run typecheck && npm run typecheck:frontend",
    "lint": "oxlint -c config/oxlintrc.json --ignore-pattern dist --ignore-pattern apps/frontend/dist --ignore-pattern agents --ignore-pattern scripts/diagram --ignore-pattern scripts/diagram-page.ts --type-aware --type-check --deny-warnings",
    "lint:fix": "oxlint -c config/oxlintrc.json --ignore-pattern dist --ignore-pattern apps/frontend/dist --ignore-pattern agents --ignore-pattern scripts/diagram --ignore-pattern scripts/diagram-page.ts --type-aware --type-check --deny-warnings --fix",
    "setup": "npx tsx src/cli/setup.ts",
    "create-agent": "npx tsx src/cli/create-agent.ts",
    "delete-agent": "npx tsx src/cli/delete-agent.ts",
    "deploy": "npx tsx src/cli/deploy.ts",
    "chat": "npx tsx src/cli/chat.ts",
    "serve": "npx tsx src/server/api.ts",
    "mcp": "npx tsx src/mcp/server.ts",
    "mcp:http": "npx tsx src/mcp/server.ts --http",
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "dev": "concurrently --kill-others-on-fail --names \"api,mcp,frontend\" --prefix-colors \"cyan,green,magenta\" \"npm run serve\" \"npm run mcp:http\" \"sleep 3 && npm --prefix apps/frontend run dev\"",
    "frontend": "npm --prefix apps/frontend run dev",
    "frontend:build": "npm --prefix apps/frontend run build",
    "preview": "npm --prefix apps/frontend run preview",
    "test": "npx tsx src/cli/test-workflow.ts",
    "test:unit": "vitest run --config config/vitest.config.ts",
    "test:e2e": "playwright test -c config/playwright.config.ts",
    "test:e2e:offline": "playwright test -c config/playwright.config.ts --grep-invert @onchain",
    "test:e2e:related": "node scripts/e2e-related.mjs",
    "test:e2e:matrix": "PLAYWRIGHT_MATRIX=all playwright test -c config/playwright.config.ts --grep-invert @onchain",
    "test:e2e:onchain": "PLAYWRIGHT_ONCHAIN=1 playwright test -c config/playwright.config.ts --grep @onchain",
    "test:e2e:ui": "playwright test -c config/playwright.config.ts --ui",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fsd": "steiger apps/frontend/src",
    "dead-code": "fallow dead-code -c config/.fallowrc.json --fail-on-issues",
    "duplicates": "fallow dupes -c config/.fallowrc.json --quiet",
    "health": "fallow health -c config/.fallowrc.json --min-score 85",
    "test:coverage": "vitest run --config config/vitest.config.ts --coverage",
    "test:mutate": "stryker run config/stryker.config.json",
    "diagram": "node scripts/architecture-diagram.mjs",
    "check": "npm run typecheck:all && npm run lint && npm run format:check && npm run fsd && npm run dead-code && npm run duplicates && npm run health && npm run test:coverage"
  },
  "dependencies": {
    "@blockbyvlog/agent0-sdk": "^1.5.6",
    "@clack/prompts": "^1.9.0",
    "@hono/node-server": "^2.1.8",
    "@langchain/anthropic": "^1.6.2",
    "@langchain/core": "^1.3.6",
    "@langchain/langgraph": "^1.7.3",
    "@langchain/openai": "^1.8.2",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@openrouter/sdk": "^1.5.76",
    "@upstash/redis": "^1.41.0",
    "dotenv": "^18.0.10",
    "ethers": "^6.17.0",
    "graphql": "^17.1.0",
    "hono": "^4.13.18",
    "qrcode-terminal": "^0.12.0",
    "viem": "^2.57.17",
    "zod": "^4.6.5",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.7",
    "danger": "^14.1.0",
    "dependency-cruiser": "^18.7.2",
    "fallow": "^3.42.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "steiger": "^0.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "22.x"
  }
}
