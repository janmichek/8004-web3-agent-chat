{
  "name": "8004-web3-agent-chat",
  "version": "0.1.0",
  "description": "Deploy autonomous AI agents on Arbitrum with LangChain, isolated wallets, and ERC-8004 identity registration.",
  "keywords": [
    "ai-agents",
    "arbitrum",
    "autonomous-agents",
    "defi",
    "erc-8004",
    "langchain",
    "web3"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:frontend": "vue-tsc -b frontend",
    "typecheck:all": "npm run typecheck && npm run typecheck:frontend",
    "setup": "npx tsx src/cli/setup.ts",
    "create-agent": "npx tsx src/cli/create-agent.ts",
    "delete-agent": "npx tsx src/cli/delete-agent.ts",
    "deploy": "npx tsx src/cli/deploy.ts",
    "chat": "npx tsx src/cli/chat.ts",
    "serve": "npx tsx src/server/api.ts",
    "dev:frontend": "vp dev frontend",
    "lint": "vp lint",
    "check": "vp check",
    "dev": "concurrently --kill-others --names \"api,frontend\" --prefix-colors \"cyan,magenta\" \"npm run serve\" \"npm run dev:frontend\"",
    "frontend": "npm run dev:frontend",
    "frontend:build": "vp build frontend",
    "preview": "vp preview frontend",
    "test": "npx tsx src/cli/test-workflow.ts",
    "test:unit": "vp test run",
    "test:e2e": "playwright test",
    "test:e2e:offline": "playwright test --grep-invert @onchain",
    "test:e2e:onchain": "PLAYWRIGHT_ONCHAIN=1 playwright test --grep @onchain",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@blockbyvlog/agent0-sdk": "^1.5.6",
    "@clack/prompts": "^1.8.1",
    "@hono/node-server": "^2.1.1",
    "@langchain/anthropic": "^1.5.10",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/openai": "^1.5.13",
    "@openrouter/sdk": "^1.2.144",
    "@tanstack/vue-query": "^5.102.8",
    "@wagmi/vue": "^0.5.30",
    "dompurify": "^3.4.15",
    "dotenv": "^18.0.0",
    "ethers": "^6.17.0",
    "graphql": "^17.0.2",
    "hono": "^4.13.8",
    "marked": "^18.0.11",
    "qrcode-terminal": "^0.12.0",
    "viem": "^2.56.3",
    "vue": "^3.5.41",
    "zod": "^4.6.5",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.6.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plus": "0.3.3",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3"
  },
  "engines": {
    "node": "24.x"
  }
}
