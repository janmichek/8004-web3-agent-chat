{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "ignorePatterns": [
    "dist/",
    "frontend/dist/",
    "coverage/",
    "agents/",
    "playwright-report/",
    "test-results/",
    "package-lock.json",
    "guide.html",
    ".stryker-tmp/",
    "reports/",
    "**/*.html",
    "docs/",
    "**/*.vue",
    "*.md"
  ],
  "overrides": [
    {
      "files": ["frontend/**", "**/tests/**", "**/*.test.ts", "vitest.config.ts"],
      "options": {
        "semi": false,
        "singleQuote": true
      }
    }
  ]
}
